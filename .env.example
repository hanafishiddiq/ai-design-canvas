AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_EDIT_MODEL=gpt-5.6-terra
OPENPENCIL_ENDPOINT=http://127.0.0.1:3100/mcp
OPENPENCIL_TOKEN=

# Optional hardening for public deployments.
# Same-origin browser calls work without ADC_API_TOKEN; this token enables trusted external callers.
ADC_API_TOKEN=
ADC_API_ALLOW_ORIGINS=
# Remote/no-Origin MCP clients should configure and send this token.
ADC_MCP_TOKEN=
ADC_MCP_ALLOW_ORIGINS=
OPENAI_QA_MODEL=gpt-5.6-terra
